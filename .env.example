# Copy to .env for docker compose (and .env.local for Next.js settings).
# Never commit the real .env.

# Postgres (docker-compose.yml)
POSTGRES_DB=horizon
POSTGRES_USER=horizon
POSTGRES_PASSWORD=horizon
POSTGRES_PORT=5432

# Go API (docker-compose.yml)
API_PORT=8080
CORS_ORIGINS=http://localhost:3000

# Only for running the Go server outside Docker (cd server && go run ./cmd/api)
DATABASE_URL=postgres://horizon:horizon@localhost:5432/horizon?sslmode=disable
