{
  "name": "sc-horizon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-review-inventory-assets.mjs && vinext dev",
    "build": "node scripts/build-review-inventory-assets.mjs && vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:watch-labs": "node --test scripts/test-watch-labs.mjs",
    "crawl:news": "python3 scripts/crawl-ai-watch.py",
    "crawl:training": "node scripts/crawl-ai-training.mjs",
    "inventory:assets": "node scripts/build-review-inventory-assets.mjs",
    "inventory:refine": "node scripts/apply-inventory-wording-refinements.mjs && node scripts/apply-thai-review-translations.mjs && node scripts/scan-review-artifact-needs.mjs && node scripts/build-review-inventory-assets.mjs",
    "test:news-scout": "python3 scripts/test-crawl-ai-watch.py"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "type": "module"
}
